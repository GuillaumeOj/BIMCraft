# Exact versions of the CLI tools used by hooks, scripts and CI (AGENTS.md §4).
# CI reads this file; keep it in sync with .github/workflows/*.yml.
# Renovate bumps each version from the `# renovate:` comment above it (.github/renovate.json5).
# renovate: datasource=npm depName=bun
BUN_VERSION=1.4.2
# renovate: datasource=crate depName=cargo-audit
CARGO_AUDIT_VERSION=0.22.2
# renovate: datasource=crate depName=cargo-cyclonedx
CARGO_CYCLONEDX_VERSION=0.5.9
# renovate: datasource=crate depName=cargo-deny
CARGO_DENY_VERSION=0.20.2
# renovate: datasource=crate depName=cargo-fuzz
CARGO_FUZZ_VERSION=0.13.2
# renovate: datasource=crate depName=cargo-llvm-cov
CARGO_LLVM_COV_VERSION=0.9.1
# renovate: datasource=crate depName=taplo-cli
TAPLO_VERSION=0.10.0
# renovate: datasource=crate depName=typos-cli
TYPOS_VERSION=1.50.3
# renovate: datasource=github-releases depName=gitleaks/gitleaks extractVersion=^v(?<version>.+)$
GITLEAKS_VERSION=8.30.1
# renovate: datasource=github-releases depName=rhysd/actionlint extractVersion=^v(?<version>.+)$
ACTIONLINT_VERSION=1.7.12
# renovate: datasource=crate depName=mdbook
MDBOOK_VERSION=0.5.4
# renovate: datasource=crate depName=wasmtime-cli
WASMTIME_VERSION=49.0.1
