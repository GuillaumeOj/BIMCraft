          "description": "Linear thermal expansion coefficient, per kelvin."
        }
      },
      "required": [
        "name",
        "category",
        "behaviour_law"
      ],
      "type": "object"
    },
    "MaterialCategory": {
      "description": "What a material is; it decides which properties it gives and which behaviour laws suit it.",
      "enum": [
        "concrete",
        "reinforcement",
        "steel",
        "timber",
        "masonry",
        "insulation",
        "finish",
        "generic"
      ],
      "type": "string"
    },
    "MaterialOriginal": {
      "additionalProperties": false,
      "description": "The library value of a material property that the user has since edited, kept with its source so that resetting the property restores it (MAT-02, ADR 0019). A material has at most one per property.",
      "properties": {
        "key": {
          "description": "The name of the edited `Material` attribute, such as `fck`.",
          "type": "string"
        },
        "material": {
          "$ref": "#/$defs/ObjectId",
          "description": "The material whose property was edited."
        },
        "value": {
          "additionalProperties": false,
          "description": "The library value, in the attribute's SI unit, with the document and clause it comes from.",
          "properties": {
            "source": {
              "$ref": "#/$defs/Source"
            },
            "value": {
              "type": "number"
            }
          },
          "required": [
            "value",
            "source"
          ],
          "type": "object"
        }
      },
      "required": [
        "material",
        "key",
        "value"
      ],
      "type": "object"
    },
    "ObjectId": {
      "description": "The stable 128-bit identifier of an object, as an IFC GlobalId.",
      "pattern": "^[0-3][0-9A-Za-z_$]{21}$",
      "type": "string"
    },
    "Site": {
      "additionalProperties": false,
      "description": "The piece of land the project stands on, and where it lies on Earth: the projected coordinate reference system, the base point, the grid rotation, the scale and an optional survey point (GEOREF-01, ADR 0017). A project has at most one site.",
      "properties": {
        "base_point_eastings": {
          "default": 0.0,
          "description": "Easting of the project base point, the origin of the local frame.\n\nIn m.",
          "type": "number"
        },
        "base_point_height": {
          "default": 0.0,
          "description": "Orthogonal height of the project base point.\n\nIn m.",
          "type": "number"
        },
        "base_point_northings": {
          "default": 0.0,
          "description": "Northing of the project base point.\n\nIn m.",
          "type": "number"
        },
        "crs_epsg": {
          "anyOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": -9223372036854775808,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "EPSG code of the projected coordinate reference system, such as 2154 for Lambert-93. Unset: the project is not georeferenced."
        },
        "grid_rotation": {
          "default": 0.0,
          "description": "Angle from the grid easting axis of the coordinate reference system to the local x-axis, counter-clockwise.\n\nIn rad.",
          "type": "number"
        },
        "scale": {
          "default": 1.0,
          "description": "Map conversion scale from local lengths to map lengths, applied to all three axes. Finite and greater than zero.",
          "type": "number"
        },
        "survey_point_eastings": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Easting of the survey point, a known point such as a benchmark. Unset: no survey point.\n\nIn m."
        },
        "survey_point_height": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Orthogonal height of the survey point.\n\nIn m."
        },
        "survey_point_northings": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Northing of the survey point.\n\nIn m."
        }
      },
      "type": "object"
    },
    "Source": {
      "description": "Where a value comes from: the document and clause it is taken from, or the user who entered it.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "clause": {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            "document": {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            }
          },
          "required": [
            "document",
            "clause"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "entered_by_user": {
              "const": true
            }
          },
          "required": [
            "entered_by_user"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$id": "urn:bimcraft:schema:core",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Objects of the `core` schema, version 3.",
  "title": "BIMCraft `core` schema"
}
