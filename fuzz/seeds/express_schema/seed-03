SCHEMA s;
FUNCTION f (l : LIST [0:?] OF GENERIC : T; n : INTEGER) : LOGICAL;
LOCAL i : INTEGER := 0; END_LOCAL;
REPEAT i := 1 TO n BY 2 WHILE i < 9 UNTIL i > 5;
  IF SIZEOF(QUERY(t <* l | t :<>: l[i])) > 0 THEN ESCAPE; ELSE SKIP; END_IF;
  CASE i OF 1, 2 : RETURN (TRUE); OTHERWISE : ; END_CASE;
END_REPEAT;
RETURN ({0 < i <= n} AND NOT (i = 2 ** 3) OR (i MOD 2 = 1));
END_FUNCTION;
RULE r FOR (x); WHERE SIZEOF(x) = 1; END_RULE;
ENTITY x; END_ENTITY;
END_SCHEMA;
