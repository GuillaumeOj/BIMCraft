#!/bin/sh
# Refuses to push unless HEAD was stamped as reviewed (AGENTS.md §1), then runs only the checks
# the branch's changes can break (scripts/affected.ts). BIMCRAFT_FULL_CHECKS=1 runs them all.
set -eu

root=$(git rev-parse --show-toplevel)
stamp="$(git rev-parse --git-dir)/bimcraft-review-stamp"
head=$(git rev-parse HEAD)

if [ ! -f "$stamp" ] || [ "$(cat "$stamp")" != "$head" ]; then
  cat >&2 <<MSG
pre-push: HEAD ($head) has not been marked as reviewed.

Before pushing:
  1. The user runs a code review of the changes   (Claude Code: /code-review)
  2. The user runs a simplification pass          (Claude Code: /simplify)
  3. Fixes are committed, then the user approves:  scripts/mark-reviewed.sh

Any new commit after the stamp requires a new review.
MSG
  exit 1
fi

# Git passes the remote name as $1; the branch is compared with that remote's main. If the scope
# cannot be computed, everything runs.
if [ "${BIMCRAFT_FULL_CHECKS:-0}" != 1 ] && scope=$(bun "$root/scripts/affected.ts" "$root" "$1/main"); then
  eval "$scope"
  echo "pre-push: running $SECTIONS${CRATES:+ on $CRATES} (BIMCRAFT_FULL_CHECKS=1 runs everything)"
  CHECK_CRATES="$CRATES" exec "$root/scripts/check-all.sh" $SECTIONS
fi
exec "$root/scripts/check-all.sh"
