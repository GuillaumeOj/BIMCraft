<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration "program" (ENG-05, docs/dev/release.md): the first Windows
  signing round. The release workflow uploads fabrilo.exe alone, at the root of a GitHub
  artifact, before it is packed into the installers. Paste this file into the SignPath project
  when it changes.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="fabrilo.exe">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
