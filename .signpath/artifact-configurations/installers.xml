<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration "installers" (ENG-05, docs/dev/release.md): the second Windows
  signing round. The release workflow uploads the installers built around the signed program, at
  the root of a GitHub artifact: the per-user NSIS installer always, the MSI package for stable
  releases only (WiX accepts no pre-release version). Paste this file into the SignPath project
  when it changes.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="Fabrilo_*_x64-setup.exe">
      <authenticode-sign />
    </pe-file>
    <msi-file path="Fabrilo_*_x64_en-US.msi" min-occurs="0">
      <authenticode-sign />
    </msi-file>
  </zip-file>
</artifact-configuration>
